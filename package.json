{
  "name": "esteira-repasse",
  "version": "1.1.0",
  "description": "Esteira do Repasse — Grupo Carburgo",
  "main": "./out/main/index.js",
  "author": "Grupo Carburgo",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push --include-seed",
    "db:test": "supabase test db --linked",
    "db:types": "supabase gen types typescript --linked --schema public > src/shared/database.types.ts",
    "e2e": "electron-vite build && playwright test",
    "release": "npm test && npm run build && electron-builder --win --publish always",
    "icone": "electron-vite build && node scripts/gerar-icone.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^6.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.61.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "supabase": "^2.121.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rrenatotc/esteiraRepasse.git"
  }
}
